{
  "name": "kesif-photos",
  "private": true,
  "description": "Keşif photo server (Cloudflare Worker + R2 + D1)",
  "scripts": {
    "dev": "wrangler dev --local --var ALLOW_UNCHECKED:1",
    "db:local": "wrangler d1 execute kesif-photos --local --file=schema.sql",
    "db:remote": "wrangler d1 execute kesif-photos --remote --file=schema.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.157.0"
  }
}
